# ─────────────────────────────────────────────────────────────
# CUSTOMS360 — Environment Variables
# Copy to .env for local dev. Set all of these on Railway.
# ─────────────────────────────────────────────────────────────

# Required: your Google Sheet ID (from the URL)
# https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# Required: full JSON key for your Google Cloud service account
# Paste the entire contents of the downloaded .json file as one line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Required: Groq API key for the AI Recommendations page
# Get yours free at console.groq.com
GROQ_API_KEY=gsk_...

# DEMO MODE — set to true during live presentations
# Drops cache TTL to 15 seconds so new Sheet rows appear almost instantly
# Set to false (or remove) in production to use 5-minute caching
DEMO_MODE=true

# Optional: override cache TTL in seconds (ignored when DEMO_MODE=true)
# CACHE_TTL_SECONDS=300

# Optional: internal URL of the Python AI microservice on Railway
AI_SERVICE_URL=

# Set automatically by Railway — do not override
# PORT=3001
